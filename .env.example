# Supabase (Project Settings → API). Son claves públicas: RLS protege los datos.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Clave publicable nueva (sb_publishable_...) o la anon key legacy
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# URL pública del sitio (metadata y Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Acceso de demo en un clic en /login (cuentas del seed). "off" lo desactiva.
DEMO_ACCESS=on
DEMO_PASSWORD=123456
